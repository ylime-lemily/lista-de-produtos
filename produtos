produtos = []
categoria = []

combinados = list(zip(produtos, categoria))
print(combinados)

while True:
    print("Seja Bem vindo ao Supermercado!")
    print("*************************************\n")
    print("O que deseja fazer hoje? ")
    print("1 - inserir produtos ")
    print("2 - alterar produtos ")
    print("3 - revover produtos")
    print("4 - terminei.")

    comando = input("Digite o nome do produto: ")
    if comando == '1' : #Adicionar
        produto_novo = input("Digite o nome do novo produto: ")
        categoria_produto = input("Digite a categoria do produto: ")
        produto = [produto_novo, categoria_produto]
        produtos.append(produto)

    if comando == '2' : #Alterar
        produto_antigo = input("Digite o nome do produto que você deseja alterar: ")
        produto_novo = input("Digite o nome do novo produto: ")
        if produto_antigo in produtos:
            indice = produtos.index(produto_antigo)
            produtos[indice] = produto_novo
            print(f"lista atualizada: [produtos] ")
        else:
            print("o item informado não está na lista.")

        if comando == '3' :
            produto_remover = input("Digite o nome do produto que deseja remover: ")
            produtos.remove(produto_remover)

        if comando == '4' :  #Sair
            print(produtos)
            break







